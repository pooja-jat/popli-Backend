model ChatModerationFlag {
  id                String                  @id @default(uuid())
  chatId            String
  messageId         String?
  reporterId        String?
  flagType          ChatFlagType
  reason            String
  severity          ChatFlagSeverity        @default(LOW)
  status            ChatFlagStatus          @default(OPEN)
  confidenceScore   Float                   @default(0.0)
  detectedKeywords  String[]                @default([])
  detectedLinks     String[]                @default([])
  aiExplanation     String?
  createdAt         DateTime                @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  chat              Chat                    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  actions           ChatModerationAction[]

  @@index([chatId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model ChatModerationAction {
  id         String              @id @default(uuid())
  flagId     String
  adminId    String
  action     ChatActionType
  reason     String?
  targetUserId String?
  previousState Json?
  newState    Json?
  createdAt  DateTime            @default(now())
  flag       ChatModerationFlag  @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@index([adminId])
}

