  status            PaymentStatus @default(PENDING)
  gateway           String        @default("RAZORPAY")
  paymentMethod     String?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           CoinRefund[]

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

